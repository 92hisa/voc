# このファイルは環境変数の見本。コピーして .env を作り、実際の値を入れる（.env はコミットしない）。
#   cp .env.example .env

# --- AI（分類・クラスタ名の生成） ---
# https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=
# 使うモデル。安く回したいときは claude-haiku-4-5 なども指定できる
AI_MODEL=claude-opus-5

# --- YouTube Data API v3（コメント収集。1日1万ユニットのクォータ） ---
# Google Cloud コンソールで「YouTube Data API v3」を有効にして発行
YOUTUBE_API_KEY=

# --- Bluesky（AT Protocol） ---
# ハンドル（例: example.bsky.social）と、設定画面で作る「アプリパスワード」
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- メール送信（Resend） ---
RESEND_API_KEY=
# 送信元アドレスと、メール内リンクのホスト名
MAIL_FROM=
APP_HOST=localhost:3000

# --- 計測 ---
GA4_ID=
META_PIXEL_ID=

# --- 本番（Render）だけで使う ---
# 永続ディスク上のDBファイルの置き場所。キャッシュ用・ジョブ用のDBも同じフォルダに作られる
DATABASE_PATH=/data/production.sqlite3
