<%# このファイルは検索語で公開投稿を一覧表示する画面。ここが threads_keyword_search の使いどころ %>
<% content_for :title, "Threadsの投稿を表示｜#{service_name}" %>

<%= render "steps", current: 3 %>

<h1 class="text-3xl font-bold tracking-tight">検索語で公開投稿を表示する</h1>

<p class="mt-6 leading-7 text-gray-700">
  オーディエンス（誰の声を集めるか）を選ぶと、そのオーディエンス向けに用意した検索語が出ます。
  検索語を選ぶと、Threadsの<strong>直近7日の公開投稿</strong>を
  <code class="font-mono text-sm">threads_keyword_search</code> で取得して表示します。
  この画面では保存はしません。
</p>

<%= form_with url: threads_search_path, method: :get, class: "mt-8 rounded-lg bg-gray-50 p-6" do |form| %>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end">
    <div class="flex-1">
      <%= form.label :audience_slug, "オーディエンス", class: "block text-sm font-bold text-gray-700" %>
      <%= form.select :audience_slug,
            @audiences.map { |audience| [ audience.name, audience.slug ] },
            { selected: @audience&.slug },
            class: "mt-2 w-full rounded-lg border border-gray-300 px-3 py-2" %>
    </div>

    <div class="flex-1">
      <%= form.label :query, "検索語", class: "block text-sm font-bold text-gray-700" %>
      <%= form.select :query,
            @queries.map { |audience_query| [ audience_query.query, audience_query.query ] },
            { selected: @query },
            class: "mt-2 w-full rounded-lg border border-gray-300 px-3 py-2" %>
    </div>

    <%= form.submit "投稿を表示", class: "rounded-lg bg-gray-900 px-6 py-2.5 font-bold text-white hover:bg-gray-700" %>
  </div>
<% end %>

<% if @queries.empty? %>
  <p class="mt-8 rounded-lg bg-amber-50 p-4 text-sm leading-6 text-amber-900">
    このオーディエンスにはThreads用の検索語がありません。
    <code class="font-mono">bin/rails queries:generate[<%= @audience&.slug %>,threads]</code> で作成してください。
  </p>
<% elsif @error %>
  <div class="mt-8 rounded-lg bg-amber-50 p-4 text-sm leading-6 text-amber-900">
    <p class="font-bold">投稿を取得できませんでした。</p>
    <p class="mt-2 break-all"><%= @error %></p>
    <p class="mt-2">
      <code class="font-mono">threads_keyword_search</code> はアプリ審査が必要な権限です。
      審査前は、アプリに役割（管理者・開発者・テスター）のあるアカウントでのみ使えます。
    </p>
  </div>
<% elsif @posts %>
  <h2 class="mt-12 text-lg font-bold">
    「<%= @query %>」の検索結果：<%= @posts.size %>件
  </h2>

  <% if @posts.empty? %>
    <p class="mt-4 leading-7 text-gray-700">直近7日にこの検索語を含む公開投稿はありませんでした。</p>
  <% else %>
    <ul class="mt-6 space-y-4">
      <% @posts.each do |post| %>
        <li class="rounded-lg border border-gray-200 p-5">
          <p class="whitespace-pre-line leading-7 text-gray-900"><%= post["text"] %></p>
          <p class="mt-3 text-sm text-gray-500">
            <%= Time.zone.parse(post["timestamp"].to_s)&.strftime("%Y年%-m月%-d日 %H:%M") %>
            <% if post["permalink"].present? %>
              ・<%= link_to "元の投稿を見る", post["permalink"], class: "underline hover:text-gray-900", rel: "noopener", target: "_blank" %>
            <% end %>
          </p>
        </li>
      <% end %>
    </ul>

    <p class="mt-8 text-sm leading-6 text-gray-500">
      表示しているのは投稿の本文・投稿日時・元の投稿へのリンクだけです。
      投稿者の氏名・アカウント名・アイコンは取得していません。
    </p>
  <% end %>
<% end %>

<div class="mt-12 border-t border-gray-200 pt-6">
  <%= button_to "Threadsの連携を解除する", threads_logout_path, method: :delete,
        class: "text-sm text-gray-500 underline hover:text-gray-900" %>
</div>
