<%# このファイルは連携の入口。ここから審査の録画を始める %>
<% content_for :title, "Threads連携｜#{service_name}" %>

<%= render "steps", current: 1 %>

<h1 class="text-3xl font-bold tracking-tight">Threadsと連携する</h1>

<p class="mt-6 leading-7 text-gray-700">
  <%= service_name %>は、Threadsの<strong>公開投稿</strong>をキーワードで探し、
  「悩み」「探している」「お金の話」「乗り換え」「話題」の5つの切り口に分類して、
  小さな会社や個人事業主に<strong>週ごとの傾向</strong>としてお届けします。
  そのために、下の権限を使わせていただきます。
</p>

<h2 class="mt-10 text-lg font-bold">お願いする権限</h2>
<ul class="mt-4 space-y-3">
  <li class="rounded-lg bg-gray-50 p-4 leading-7 text-gray-700">
    <code class="font-mono text-sm">threads_basic</code><br>
    連携したアカウントを確認するために必要です。
  </li>
  <li class="rounded-lg bg-gray-50 p-4 leading-7 text-gray-700">
    <code class="font-mono text-sm">threads_keyword_search</code><br>
    検索語で<strong>公開投稿</strong>を探すために使います。これが本サービスの中心です。
  </li>
</ul>

<p class="mt-6 leading-7 text-gray-700">
  投稿の<strong>本文・投稿日時・投稿へのリンク</strong>だけを扱います。
  投稿者の氏名・アカウント名・アイコン・プロフィールは取得も保存も表示もせず、
  個人を追跡したり一覧にしたりすることはありません。詳しくは
  <%= link_to "プライバシーポリシー", privacy_path, class: "underline hover:text-gray-900" %>と
  <%= link_to "データ削除の手順", data_deletion_path, class: "underline hover:text-gray-900" %>をご覧ください。
</p>

<div class="mt-10">
  <% if @logged_in %>
    <p class="mb-4 rounded-lg bg-green-50 p-4 text-sm text-green-900">すでに連携しています。</p>
    <%= link_to "検索語で投稿を表示する", threads_search_path,
          class: "inline-block rounded-lg bg-gray-900 px-6 py-3 font-bold text-white hover:bg-gray-700" %>
    <%= button_to "連携を解除する", threads_logout_path, method: :delete,
          class: "mt-4 text-sm text-gray-500 underline hover:text-gray-900" %>
  <% elsif @configured %>
    <%# 外部ドメインへ飛ぶので、Turboに触らせないふつうのリンクにする %>
    <%= link_to "Threadsでログイン", @authorize_url, data: { turbo: false },
          class: "inline-block rounded-lg bg-gray-900 px-6 py-3 font-bold text-white hover:bg-gray-700" %>
  <% else %>
    <p class="rounded-lg bg-amber-50 p-4 text-sm leading-6 text-amber-900">
      環境変数 <code class="font-mono">THREADS_APP_ID</code> と <code class="font-mono">THREADS_APP_SECRET</code>
      が設定されていないため、ログインできません。
    </p>
  <% end %>
</div>

<p class="mt-10 text-sm text-gray-500">
  リダイレクトURI：<code class="font-mono"><%= @redirect_uri %></code>
</p>
