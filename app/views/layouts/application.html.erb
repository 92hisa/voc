<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || service_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="<%= service_name %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# tailwind.css は bin/rails tailwindcss:build で app/assets/builds に作られる %>
    <%= stylesheet_link_tag "tailwind", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-white text-gray-900 antialiased">
    <main class="mx-auto max-w-3xl px-6 py-16">
      <% if flash[:notice] %>
        <p class="mb-8 rounded-lg bg-green-50 p-4 text-sm text-green-900"><%= flash[:notice] %></p>
      <% end %>
      <% if flash[:alert] %>
        <p class="mb-8 rounded-lg bg-amber-50 p-4 text-sm text-amber-900"><%= flash[:alert] %></p>
      <% end %>

      <%= yield %>
    </main>

    <footer class="mx-auto max-w-3xl border-t border-gray-200 px-6 py-10 text-sm text-gray-500">
      <p class="mb-3"><%= service_name %></p>
      <nav class="flex flex-wrap gap-x-6 gap-y-2">
        <%= link_to "プライバシーポリシー", privacy_path, class: "underline hover:text-gray-900" %>
        <%= link_to "利用規約", terms_path, class: "underline hover:text-gray-900" %>
        <%= link_to "データ削除の手順", data_deletion_path, class: "underline hover:text-gray-900" %>
      </nav>
    </footer>
  </body>
</html>
